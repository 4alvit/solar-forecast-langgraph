        "format": "sdist",
        "package": "solar-forecast-langgraph",
        "value": "package",
        "ecosystem": "pep440"
      },
      {
        "path": "solar-forecast-langgraph-container.oci.tar",
        "format": "oci",
        "field": [
          "config",
          "Labels",
          "org.opencontainers.image.version"
