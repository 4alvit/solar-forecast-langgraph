        "field": "project.version",
        "package": "solar-forecast-langgraph",
        "value": "package",
        "ecosystem": "pep440"
      },
      {
        "path": "*.whl",
        "format": "wheel",
        "package": "solar-forecast-langgraph",
        "value": "package",
        "ecosystem": "pep440"
      },
