    "solar_forecast_langgraph-*.tar.gz"
  ],
  "visibility": "public",
  "single_entry_ci": true,
  "release_notes": "CHANGELOG.md",
  "versioning": {
    "schema": 1,
    "promotion": "promote-bytes",
    "files": [
      {
        "path": "pyproject.toml",
        "format": "toml",
        "field": "project.version",
        "package": "solar-forecast-langgraph",
        "value": "package",
        "ecosystem": "pep440"
      },
      {
        "path": "uv.lock",
        "format": "uv-lock",
        "package": "solar-forecast-langgraph",
        "value": "package",
        "ecosystem": "pep440"
      }
    ],
    "artifacts": [
      {
        "path": "solar-forecast-langgraph-*.tar.gz",
        "format": "tar-toml",
